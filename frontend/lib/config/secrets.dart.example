// 템플릿: secrets.dart로 복사한 뒤 Firebase 콘솔 값으로 채움 (secrets.dart는 .gitignore 대상)
// 값이 비어 있으면 Firebase 초기화를 건너뜀
class BeeperSecrets {
  BeeperSecrets._();

  // 백엔드 API 서버 주소 (배포 시 이 값만 수정, 끝에 / 없이 입력)
  // 시그널링(WebSocket) 주소도 이 값에서 자동 생성 (http > ws, https > wss)
  static const String apiBaseUrl = 'http://localhost:5500';

  static const String firebaseApiKey =
      "YOUR_FIREBASE_API_KEY";
  static const String firebaseAuthDomain = 'YOUR_PROJECT_ID.firebaseapp.com';
  static const String firebaseProjectId = 'YOUR_PROJECT_ID';
  static const String firebaseStorageBucket =
      "YOUR_PROJECT_ID.firebasestorage.app";
  static const String firebaseMessagingSenderId = 'YOUR_MESSAGING_SENDER_ID';
  static const String firebaseAppId =
      'YOUR_FIREBASE_APP_ID';

  // 웹에서 FCM 토큰 발급 시 필요 (Android/iOS는 불필요)
  // Firebase 콘솔 > 프로젝트 설정 > 클라우드 메시징 > 웹 푸시 인증서에서 발급
  // 비어 있으면 웹에서 토큰 발급 실패
  static const String firebaseVapidKey =
      'YOUR_WEB_PUSH_VAPID_KEY';

  // Firebase 설정값이 모두 채워졌는지 확인 (하나라도 비면 초기화 스킵)
  static bool get isFirebaseConfigured =>
      firebaseApiKey.isNotEmpty &&
      firebaseAuthDomain.isNotEmpty &&
      firebaseProjectId.isNotEmpty &&
      firebaseStorageBucket.isNotEmpty &&
      firebaseMessagingSenderId.isNotEmpty &&
      firebaseAppId.isNotEmpty;

  // 추가 시크릿 키는 여기에 추가
}
